# Safe, documented configuration template for the plain-WSGI taskboard.
#
# Copy to .env (or export directly) and adjust. No secrets are required:
# every value here is development-safe. The process supervisor exports these
# variables to the WSGI server; the application also reads them directly.

# Bind address and port for the Waitress WSGI server.
PORT=8080
BIND_HOST=0.0.0.0

# Base data directory (gitignored). Mount a persistent volume here in
# production so the SQLite file survives redeploys.
DATA_DIR=./data

# Explicit persistent SQLite path. Defaults to <DATA_DIR>/taskboard.db.
DATABASE_PATH=./data/taskboard.db

# Non-sensitive release/build marker shown in /api/meta and the UI footer.
# Defaults to the git short SHA at build time.
BUILD_MARKER=local-dev

# Optional URL prefix when the app is served under a sub-path.
BASE_PATH=